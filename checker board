#include <iostream>
using namespace std;

int main() {
    int rows, cols;

    // Input the number of rows and columns
    cout << "Enter number of rows: ";
    cin >> rows;
    cout << "Enter number of columns: ";
    cin >> cols;

    // Nested loops to print checkerboard pattern
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            // If sum of row and column indices is even, print a star
            if ((i + j) % 2 == 0)
                cout << "* ";
            else
                cout << "  "; // Two spaces for better alignment
        }
        cout << endl; // Move to next row
    }

    return 0;
}
